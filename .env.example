# Atheric AI Environment Configuration Template

PORT=5000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
JWT_SECRET=your_jwt_secret_key_here
DB_PATH=data/atheric_app.db
MARKET_DB_PATH=data/idx_scraped_data.db

# Resend Email API Configuration
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=Atheric AI <onboarding@resend.dev>

# Google Gemini AI API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Scraper & VPS Synchronization
SYNC_SECRET_KEY=your_sync_secret_key_here
