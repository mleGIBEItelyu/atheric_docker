# Atheric AI Environment Configuration Template

PORT=5000
ALLOWED_ORIGINS=https://atheric.id,http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://localhost,http://localhost:80
JWT_SECRET=your_jwt_secret_key_here
DB_PATH=data/atheric_app.db
MARKET_DB_PATH=data/idx_scraped_data.db
GENESIS_API_URL=http://genesis-service:8000
GENESIS_ENCRYPTION_KEY=your_genesis_encryption_key_here

# Scraper & VPS Synchronization
SYNC_SECRET_KEY=your_sync_secret_key_here

# ============================================
# Atheric AI — Docker Compose Environment
# ============================================
# Copy this file to .env and fill in your production values:
#   cp .env.example .env
#
# IMPORTANT: Never commit .env to git!

# --- Google Gemini AI (untuk fitur AI Chat) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-pro-latest
# --- Resend Email API (untuk OTP verification email) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=Atheric AI <onboarding@resend.dev>
