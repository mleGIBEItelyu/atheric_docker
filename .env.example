# Atheric AI Monorepo - Docker Environment Variables

# Backend Core Configuration
PORT=5000
ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://localhost:5173,http://127.0.0.1
JWT_SECRET=atheric_ai_super_secret_jwt_key_2026_change_in_prod
DB_PATH=/app/data/atheric.db

# Resend Email API Configuration
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=Atheric AI <onboarding@resend.dev>

# Google Gemini AI API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Frontend Configuration
VITE_API_URL=http://localhost:5000
